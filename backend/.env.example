# Copy this file to backend/.env and fill in what you need. backend/.env is git-ignored.

# Long random string used to sign login tokens. If unset, one is generated into backend/.secret_key.
# SECRET_KEY=

# Defaults to backend/dev.db (absolute path, so it doesn't matter where you start the server)
# DATABASE_URL=sqlite:///C:/path/to/runcoach.db

# How long a login lasts, in minutes (default 30 days)
# ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Free key from https://openweathermap.org/api - without it the weather endpoints return clearly labelled sample data
# OPENWEATHER_API_KEY=

# Comma-separated emails allowed to create training plans through the API
# ADMIN_EMAILS=you@example.com

# 1 = enable the "dev-token" login bypass and /training-plans debug endpoints. NEVER on a public server.
# RUNCOACH_DEV_MODE=1

# Comma-separated allowed web origins (the mobile app doesn't need this)
# CORS_ORIGINS=*
